  +setControl(Control) : void
  +getDataStore() : DataStore
  +setDataStore(DataStore) : void
  -crearMenu() : JMenuBar
  -{static} item(String, ActionListener) : JMenuItem
  -crearNavegacion() : JPanel
  +mostrar(String) : void
  -actualizarBarraEstado() : void
  +mostrarAdvertenciasDeCarga() : void
  -guardarAhora() : void
  -exportarExcel() : void
  -restaurarDatosEjemplo() : void
