  -mostrarEstudiantes(List<Estudiante>) : void
  -editarEstudiante() : void
  -eliminarEstudiante() : void
  -menuConvenios() : void
  -agregarConvenio() : void
  -mostrarConvenios(List<Convenio>) : void
  -editarConvenio() : void
  -eliminarConvenio() : void
  -elegirRequisitos(Set<TipoDocumento>) : Set<TipoDocumento>
  -menuTramites() : void
  -crearTramite() : void
  -listarTramites() : void
  -mostrarTramites(List<Tramite>) : void
  -verDetalleTramite() : void
