abstract class PanelBase {
  -control : Control
  -alCambiarDatos : Runnable
  --
  #PanelBase(Control, String, String)
  +getControl() : Control
  +setControl(Control) : void
  +getAlCambiarDatos() : Runnable
  +setAlCambiarDatos(Runnable) : void
  +{abstract} actualizar() : void
  #notificarCambio() : void
  #{static} crearModelo(String...) : DefaultTableModel
  #{static} crearTabla(DefaultTableModel) : JTable
  #{static} claveSeleccionada(JTable) : String
  #{static} seleccionarClave(JTable, String) : void
  #{static} crearBoton(String, ActionListener) : JButton
  #{static} crearBarra() : JPanel
  #{static} crearBuscador(Runnable) : JTextField
  #mostrarError(Exception) : void
  #mostrarAviso(String) : void
  #mostrarInfo(String) : void
  #confirmar(String) : boolean
}
class PanelConvenios {
  -modelo : DefaultTableModel
  -tabla : JTable
