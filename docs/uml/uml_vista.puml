}
}
PanelTramites +-- PanelTramites_RenderEstado
class JFrame <<Java>>
class JPanel <<Java>>
class JDialog <<Java>>

package "control / persistencia / reportes" as otros {
  class Control
  class DataStore
  class Reporte
}
VentanaPrincipal --> Control
VentanaPrincipal --> DataStore
ConsoleApp --> Control
ConsoleApp --> DataStore
PanelBase --> Control
PanelReportes ..> Reporte
Lanzador ..> Control
Lanzador ..> DataStore


JFrame <|-- VentanaPrincipal
JPanel <|-- PanelBase
JPanel <|-- GraficoBarras
JDialog <|-- DialogoEstudiante
JDialog <|-- DialogoConvenio
PanelBase <|-- PanelEstudiantes
PanelBase <|-- PanelConvenios
PanelBase <|-- PanelTramites
PanelBase <|-- PanelReportes
VentanaPrincipal "1" *-- "4" PanelBase : paneles
PanelReportes *-- GraficoBarras
PanelEstudiantes ..> DialogoEstudiante
PanelConvenios ..> DialogoConvenio
PanelTramites ..> DialogoEstudiante
Lanzador ..> VentanaPrincipal
Lanzador ..> ConsoleApp

@enduml
