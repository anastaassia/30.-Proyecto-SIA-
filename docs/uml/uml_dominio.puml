  +equals(Object) : boolean
  +hashCode() : int
  +toString() : String
}
class DocumentoSubido {
  -tipo : TipoDocumento
  -nombreArchivo : String
  -fechaSubida : LocalDate
  --
  +DocumentoSubido(TipoDocumento, String, LocalDate)
  +getTipo() : TipoDocumento
  +setTipo(TipoDocumento) : void
  +getNombreArchivo() : String
  +setNombreArchivo(String) : void
  +getFechaSubida() : LocalDate
  +setFechaSubida(LocalDate) : void
  +toString() : String
}
enum EstadoProceso {
  POSTULACION
  ACEPTADO
  RECHAZADO
  EN_CURSO
  --
  -etiqueta : String
  --
  +getEtiqueta() : String
  +toString() : String
}
enum EstadoTramite {
  EN_PROCESO
  COMPLETO
  APROBADO
  RECHAZADO
  --
  -etiqueta : String
  --
  +getEtiqueta() : String
  +esResuelto() : boolean
  +toString() : String
}
class Estudiante {
  -rut : String
  -nombre : String
  -carrera : String
  -anioIngreso : int
  -estadoProceso : EstadoProceso
  --
  +Estudiante(String, String, String, int)
  +getRut() : String
  +setRut(String) : void
  +getNombre() : String
  +setNombre(String) : void
  +getCarrera() : String
  +setCarrera(String) : void
  +getAnioIngreso() : int
