  +getEstadoProceso() : EstadoProceso
  +setEstadoProceso(EstadoProceso) : void
  +equals(Object) : boolean
  +hashCode() : int
  +toString() : String
}
enum TipoDocumento {
  CERT_NACIMIENTO
  CERT_ALUMNO_REGULAR
  PASAPORTE
  CERTIFICADO_NOTAS
  CARTA_MOTIVACION
  CV
  CERTIFICADO_IDIOMA
  --
  -etiqueta : String
  --
  +getEtiqueta() : String
  +toString() : String
}
class Tramite {
  -idTramite : String
  -estudiante : Estudiante
  -convenio : Convenio
  -documentos : Map<TipoDocumento, DocumentoSubido>
  -estado : EstadoTramite
  -observacion : String
  --
  +Tramite(String, Estudiante, Convenio)
  +getIdTramite() : String
  +setIdTramite(String) : void
  +getEstudiante() : Estudiante
  +setEstudiante(Estudiante) : void
  +getConvenio() : Convenio
  +setConvenio(Convenio) : void
  +getDocumentos() : Map<TipoDocumento, DocumentoSubido>
  +setDocumentos(Map<TipoDocumento, DocumentoSubido>) : void
