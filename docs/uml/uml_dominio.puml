  -nombre : String
  -universidadSocia : String
  -pais : String
  -duracionMeses : int
  -carreraAsociada : String
  -requisitos : Set<TipoDocumento>
  -tramites : List<Tramite>
  --
  +Convenio(String, String, String, String, int, String, Set<TipoDocumento>)
  +getIdConvenio() : String
  +setIdConvenio(String) : void
  +getNombre() : String
