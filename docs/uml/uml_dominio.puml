  +limpiar() : void
  +cargarDatosIniciales() : void
}
class Validador {
  +{static} ANIO_MINIMO : int
  --
  -Validador()
  +{static} normalizarRut(String) : String
  +{static} calcularDigitoVerificador(String) : char
  +{static} textoObligatorio(String, String) : String
  +{static} textoOpcional(String, String) : String
  +{static} anioIngreso(int) : int
  +{static} duracionMeses(int) : int
  +{static} entero(String, String) : int
}
}

package reportes {
abstract class Reporte {
  -titulo : String
  --
  #Reporte(String)
  +getTitulo() : String
  +setTitulo(String) : void
  +getDescripcion() : String
  #{abstract} generarLineas(Control) : List<String>
  #mensajeSinResultados() : String
  +generar(Control) : List<String>
  +generarTexto(Control) : String
  +toString() : String
}
class ReporteAvanceConvenios {
  +ReporteAvanceConvenios()
  +getDescripcion() : String
  #generarLineas(Control) : List<String>
  #mensajeSinResultados() : String
}
class ReporteDocumentoFaltante {
  -tipoDocumento : TipoDocumento
  -idConvenio : String
  --
  +ReporteDocumentoFaltante(TipoDocumento, String)
  +getTipoDocumento() : TipoDocumento
  +setTipoDocumento(TipoDocumento) : void
  +getIdConvenio() : String
  +setIdConvenio(String) : void
  +getDescripcion() : String
  #generarLineas(Control) : List<String>
  #mensajeSinResultados() : String
}
}

package persistencia {
class DataStore {
  +{static} SEPARADOR : String
  +{static} SEPARADOR_LISTA : String
  ~{static} CABECERA_CONVENIOS : String[]
  ~{static} CABECERA_ESTUDIANTES : String[]
  ~{static} CABECERA_TRAMITES : String[]
  ~{static} CABECERA_DOCUMENTOS : String[]
  -control : Control
  -carpeta : Path
  -advertencias : List<String>
  --
  +DataStore(Control)
  +DataStore(Control, Path)
  +getControl() : Control
  +setControl(Control) : void
  +getCarpeta() : Path
  +setCarpeta(Path) : void
  +getAdvertencias() : List<String>
  +existenArchivos() : boolean
  -archivo(String) : Path
  +cargar() : void
  -ordenarAdvertencias() : void
  -{static} numeroDeLinea(String) : int
  -cargarConvenios() : void
  -cargarEstudiantes() : void
  -cargarTramites() : Map<String, EstadoTramite>
  -cargarDocumentos() : void
  -restaurarEstados(Map<String, EstadoTramite>) : void
  +guardar() : void
  -escribir(String, String[], List<String[]>) : void
  -leer(String, String[]) : List<DataStore.Fila>
  -advertir(DataStore.Fila, String) : void
  -{static} convertirEnum(Class<E>, String, String) : <E extends Enum<E>> E
}
class "DataStore.Fila" as DataStore_Fila {
  -archivo : String
  -numero : int
  -campos : String[]
  --
  -Fila(String, int, String[])
  -campo(int) : String
}
class ExportadorExcel {
  -control : Control
  --
  +ExportadorExcel(Control)
  +getControl() : Control
  +setControl(Control) : void
  +exportar(Path) : void
  -{static} fila(Object...) : List<Object>
  -{static} hojaContentType(int) : String
  -{static} hojaRelacion(int) : String
  -{static} hoja(List<List<Object>>) : String
  -{static} escaparXml(String) : String
  -{static} agregar(ZipOutputStream, String, String) : void
}
}
DataStore +-- DataStore_Fila
package excepciones {
class ConvenioNoEncontradoException {
  +ConvenioNoEncontradoException(String)
}
class DatoInvalidoException {
  +DatoInvalidoException(String)
}
class DocumentoDuplicadoException {
  +DocumentoDuplicadoException(String)
}
class EstudianteNoEncontradoException {
  +EstudianteNoEncontradoException(String)
}
class RegistroDuplicadoException {
  +RegistroDuplicadoException(String)
}
class TramiteNoEncontradoException {
  +TramiteNoEncontradoException(String)
}
}

class Exception <<Java>>

Control "1" o-- "*" Convenio : convenios (List)
Control "1" o-- "*" Estudiante : estudiantes (HashMap por RUT)
Convenio "1" *-- "*" Tramite : tramites (List anidada)
Tramite "*" --> "1" Estudiante : estudiante
Tramite "1" *-- "*" DocumentoSubido : documentos (EnumMap)
Convenio --> "*" TipoDocumento : requisitos
DocumentoSubido --> TipoDocumento
Tramite --> EstadoTramite
Estudiante --> EstadoProceso
Control ..> Validador
Reporte <|-- ReporteDocumentoFaltante
Reporte <|-- ReporteAvanceConvenios
Reporte ..> Control
DataStore --> Control
ExportadorExcel --> Control
Control ..> excepciones : «throws»
Exception <|-- excepciones

@enduml
